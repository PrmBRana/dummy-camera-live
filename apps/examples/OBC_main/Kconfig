#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_OBC_MAIN
	tristate "\"OBC Main\" example"
	default n
	---help---
		Enable the \"OBC Main\" example

if EXAMPLES_OBC_MAIN

config EXAMPLES_OBC_MAIN_PROGNAME
	string "Program name"
	default "obc_main"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_OBC_MAIN_PRIORITY
	int "OBC Main task priority"
	default 100

config EXAMPLES_OBC_MAIN_STACKSIZE
	int "OBC Main stack size"
	default DEFAULT_TASK_STACKSIZE

endif
